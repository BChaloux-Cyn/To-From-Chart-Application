Option Explicit

Private mMarkers As Collection
Private mListPinNumbers As Collection ' mirrors lstPins - item i+1 is the PinNumber shown at lstPins index i, since list position and PinNumber diverge once anything is deleted
Private mConnectorID As String
Private mNextPinNumber As Long
Private mPhotoPath As String

Private Sub UserForm_Initialize()
    Set mMarkers = New Collection
    Set mListPinNumbers = New Collection
    mNextPinNumber = 1
    cboType.ListIndex = 0
End Sub

' Called (after Load, before Show) by frmManageLibrary's cmdEdit_Click,
' which has already seeded _Edit's scratch pins via modPinEditor.
' LoadScratchPins - this only has to populate the visible fields and
' rebuild the on-screen pin markers from that scratch data. vFields is the
' 1-based Dim vResult(1 To 11) array modLibrary.ReadConnector returns.
Public Sub LoadForEdit(ByVal sConnectorID As String, ByVal vFields As Variant, wsLibPhotos As Worksheet)
    mConnectorID = sConnectorID

    txtName.Text = CStr(vFields(2))
    txtManufacturer.Text = CStr(vFields(3))
    txtPartNumber.Text = CStr(vFields(4))
    cboType.Text = CStr(vFields(5))
    txtPinCount.Text = CStr(vFields(6))
    txtNotes.Text = CStr(vFields(7))

    LoadExistingPhoto wsLibPhotos, sConnectorID
    RebuildPinListFromScratch
End Sub

Private Sub LoadExistingPhoto(wsLibPhotos As Worksheet, ByVal sConnectorID As String)
    Dim shp As Shape
    On Error Resume Next
    Set shp = wsLibPhotos.Shapes("PHOTO_" & sConnectorID)
    On Error GoTo 0
    If shp Is Nothing Then Exit Sub

    ' EmbedConnectorPhoto (and so modPinEditor.SaveConnector) always needs a
    ' real file on disk, but a shape already embedded in the library has no
    ' such file - export it to one in TEMP so cmdSave_Click can re-embed it
    ' unchanged if the student edits fields without picking a new photo.
    Dim sTempPath As String
    sTempPath = Environ$("TEMP") & "\" & sConnectorID & "_edit.png"
    If Not ExportShapeToFile(shp, sTempPath) Then Exit Sub

    Dim pic As IPictureDisp
    Set pic = LoadPicture(sTempPath)
    If pic Is Nothing Then Exit Sub

    Dim vFit As Variant
    vFit = modPinEditor.FitAspectRatio(CDbl(pic.Width), CDbl(pic.Height), imgPhoto.Width, imgPhoto.Height)
    If IsEmpty(vFit) Then Exit Sub

    imgPhoto.PictureSizeMode = fmPictureSizeModeStretch
    imgPhoto.Picture = pic
    imgPhoto.Width = vFit(0)
    imgPhoto.Height = vFit(1)

    mPhotoPath = sTempPath
End Sub

Private Function ExportShapeToFile(shp As Shape, ByVal sPath As String) As Boolean
    ' Excel has no direct "export a Shape to an image file" call - pasting
    ' it into a throwaway ChartObject and exporting the chart is the
    ' standard workaround.
    Dim wsTemp As Worksheet, cht As ChartObject

    Set wsTemp = ThisWorkbook.Worksheets("_Edit")
    shp.Copy
    Set cht = wsTemp.ChartObjects.Add(0, 0, shp.Width, shp.Height)
    cht.Chart.Paste
    cht.Chart.Export sPath, "PNG"
    cht.Delete

    ExportShapeToFile = (Len(Dir$(sPath)) > 0)
End Function

Private Sub RebuildPinListFromScratch()
    Dim vPins As Variant, i As Long, nPinNumber As Long
    Dim dLabelX As Double, dLabelY As Double

    vPins = modLibrary.ReadPinsForConnector(ThisWorkbook.Worksheets("_Edit"), _
        modPinEditor.SCRATCH_FIRST_ROW, modPinEditor.SCRATCH_LAST_ROW, mConnectorID)
    If IsEmpty(vPins) Then Exit Sub

    For i = LBound(vPins, 1) To UBound(vPins, 1)
        nPinNumber = CLng(vPins(i, 2))
        lstPins.AddItem "Pin " & CStr(nPinNumber)
        mListPinNumbers.Add nPinNumber
        dLabelX = CDbl(vPins(i, 6))
        dLabelY = CDbl(vPins(i, 7))
        AddMarkerControl nPinNumber, dLabelX * imgPhoto.Width, dLabelY * imgPhoto.Height
        If nPinNumber >= mNextPinNumber Then mNextPinNumber = nPinNumber + 1
    Next i
End Sub

Private Sub cmdLoadPhoto_Click()
    Dim sPath As String
    sPath = Application.GetOpenFilename( _
        "Pictures (*.png; *.jpg; *.jpeg; *.bmp), *.png;*.jpg;*.jpeg;*.bmp")
    If sPath = "False" Then Exit Sub

    Dim pic As IPictureDisp
    Set pic = LoadPicture(sPath)
    If pic Is Nothing Then Exit Sub

    ' HIMETRIC-to-pixel conversion cancels out in a ratio - only the ratio
    ' between Width and Height matters here.
    Dim vFit As Variant
    vFit = modPinEditor.FitAspectRatio(CDbl(pic.Width), CDbl(pic.Height), imgPhoto.Width, imgPhoto.Height)
    If IsEmpty(vFit) Then Exit Sub

    imgPhoto.PictureSizeMode = fmPictureSizeModeStretch
    imgPhoto.Picture = pic
    imgPhoto.Width = vFit(0)
    imgPhoto.Height = vFit(1)

    mPhotoPath = sPath
    mConnectorID = modLibrary.SlugifyConnectorID(Trim$(txtPartNumber.Text), Trim$(txtName.Text))
End Sub

Private Sub imgPhoto_MouseUp(ByVal Button As Integer, ByVal Shift As Integer, _
                             ByVal X As Single, ByVal Y As Single)
    If Len(mConnectorID) = 0 Then Exit Sub

    Dim dNormX As Double, dNormY As Double
    dNormX = X / imgPhoto.Width
    dNormY = Y / imgPhoto.Height

    If tglPlacePins.Value = True Then
        Dim sLabel As String
        sLabel = "Pin " & CStr(mNextPinNumber)

        If modPinEditor.PlacePin(ThisWorkbook.Worksheets("_Edit"), mConnectorID, mNextPinNumber, _
                                 sLabel, dNormX, dNormY) Then
            AddMarkerControl mNextPinNumber, X, Y
            lstPins.AddItem sLabel
            mListPinNumbers.Add mNextPinNumber
            mNextPinNumber = mNextPinNumber + 1
        End If
    ElseIf lstPins.ListIndex >= 0 Then
        ' A pin is selected and Place Pins is off - clicking the image moves
        ' that pin's anchor. The marker travels with it only if it was still
        ' sitting on the anchor (modPinEditor.MoveAnchor decides that); either
        ' way, reposition the on-screen marker to match its new label position.
        Dim nPinNumber As Long
        nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)
        If modPinEditor.MoveAnchor(ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber, dNormX, dNormY) Then
            RepositionMarkerControl nPinNumber
        End If
    End If
End Sub

Private Sub RepositionMarkerControl(ByVal nPinNumber As Long)
    Dim marker As clsPinMarker
    On Error Resume Next
    Set marker = mMarkers(CStr(nPinNumber))
    On Error GoTo 0
    If marker Is Nothing Then Exit Sub

    Dim vPins As Variant, i As Long, dLabelX As Double, dLabelY As Double
    vPins = modLibrary.ReadPinsForConnector(ThisWorkbook.Worksheets("_Edit"), _
        modPinEditor.SCRATCH_FIRST_ROW, modPinEditor.SCRATCH_LAST_ROW, mConnectorID)
    If IsEmpty(vPins) Then Exit Sub

    For i = LBound(vPins, 1) To UBound(vPins, 1)
        If CLng(vPins(i, 2)) = nPinNumber Then
            dLabelX = CDbl(vPins(i, 6))
            dLabelY = CDbl(vPins(i, 7))
            Exit For
        End If
    Next i

    Dim lbl As MSForms.Label
    Set lbl = marker.LabelControl
    lbl.Left = imgPhoto.Left + dLabelX * imgPhoto.Width - (lbl.Width / 2)
    lbl.Top = imgPhoto.Top + dLabelY * imgPhoto.Height - (lbl.Height / 2)
End Sub

Private Sub AddMarkerControl(ByVal nPinNumber As Long, ByVal sngX As Single, ByVal sngY As Single)
    Dim lbl As MSForms.Label
    Set lbl = Me.Controls.Add("Forms.Label.1", "lblMarker" & CStr(nPinNumber), True)
    lbl.Caption = CStr(nPinNumber)
    lbl.Left = imgPhoto.Left + sngX - (lbl.Width / 2)
    lbl.Top = imgPhoto.Top + sngY - (lbl.Height / 2)
    lbl.TextAlign = fmTextAlignCenter
    lbl.BackStyle = fmBackStyleOpaque
    lbl.BackColor = RGB(255, 255, 255)
    lbl.BorderStyle = fmBorderStyleSingle

    Dim marker As clsPinMarker
    Set marker = New clsPinMarker
    marker.PinNumber = nPinNumber
    marker.ConnectorID = mConnectorID
    Set marker.ScratchSheet = ThisWorkbook.Worksheets("_Edit")
    Set marker.PhotoControl = imgPhoto
    Set marker.LabelControl = lbl
    mMarkers.Add marker, CStr(nPinNumber)
End Sub

Private Sub cmdDeletePin_Click()
    If lstPins.ListIndex < 0 Then Exit Sub
    Dim nPinNumber As Long
    nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)

    modPinEditor.RemovePin ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber
    On Error Resume Next
    Me.Controls.Remove "lblMarker" & CStr(nPinNumber)
    mMarkers.Remove CStr(nPinNumber)
    On Error GoTo 0
    mListPinNumbers.Remove lstPins.ListIndex + 1
    lstPins.RemoveItem lstPins.ListIndex
End Sub

Private Sub cmdClearPins_Click()
    modPinEditor.ClearScratchPins ThisWorkbook.Worksheets("_Edit")

    Dim marker As Variant
    For Each marker In mMarkers
        On Error Resume Next
        Me.Controls.Remove marker.LabelControl.Name
        On Error GoTo 0
    Next marker
    Set mMarkers = New Collection
    Set mListPinNumbers = New Collection
    lstPins.Clear
    mNextPinNumber = 1
End Sub

Private Sub cmdSnapLabel_Click()
    If lstPins.ListIndex < 0 Then Exit Sub
    Dim nPinNumber As Long
    nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)
    If modPinEditor.SnapLabelToPin(ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber) Then
        RepositionMarkerControl nPinNumber
    End If
End Sub

Private Sub cmdSave_Click()
    Dim lib As Workbook
    Set lib = Workbooks.Open(ThisWorkbook.Path & "\ConnectorLibrary.xlsx")

    Dim sNowUtc As String
    sNowUtc = Format$(Now, "yyyy-mm-ddThh:mm:ssZ")

    If modPinEditor.SaveConnector(lib.Worksheets("Connectors"), lib.Worksheets("Pins"), _
            lib.Worksheets("Photos"), ThisWorkbook.Worksheets("_Edit"), mConnectorID, _
            Trim$(txtName.Text), Trim$(txtManufacturer.Text), Trim$(txtPartNumber.Text), _
            cboType.Text, CLng(Val(txtPinCount.Text)), Trim$(txtNotes.Text), mPhotoPath, _
            sNowUtc, sNowUtc, "Local") Then
        lib.Save
        lib.Close SaveChanges:=False
        Unload Me
    Else
        lib.Close SaveChanges:=False
    End If
End Sub

Private Sub cmdCancel_Click()
    modPinEditor.ClearScratchPins ThisWorkbook.Worksheets("_Edit")
    Unload Me
End Sub
