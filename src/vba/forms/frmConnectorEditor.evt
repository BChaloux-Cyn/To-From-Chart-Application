Option Explicit

' imgPhoto's design-time size (form_layout.py). Fitting must target this
' fixed box, not imgPhoto.Width/Height - those get overwritten with each
' fitted result, so using them as the box would shrink the photo further
' on every subsequent load.
Private Const PHOTO_BOX_WIDTH As Double = 180
Private Const PHOTO_BOX_HEIGHT As Double = 180

' Pin marker badge size - the Label control's default size is sized for
' body text, not a small numbered dot on a photo.
Private Const PIN_MARKER_SIZE As Double = 16

Private mMarkers As Collection
Private mListPinNumbers As Collection ' mirrors lstPins - item i+1 is the PinNumber shown at lstPins index i, since list position and PinNumber diverge once anything is deleted
Private mConnectorID As String
Private mOriginalConnectorID As String ' "" for a new connector; set by LoadForEdit so Save's uniqueness check can tell "still the connector I opened" from "collides with a different one"
Private mNextPinNumber As Long
Private mPhotoPath As String

Private Sub UserForm_Initialize()
    Set mMarkers = New Collection
    Set mListPinNumbers = New Collection
    mNextPinNumber = 1

    ' Populated here (ThisWorkbook-qualified), not via RowSource: an
    ' unqualified RowSource string ("_Lists!D2:D5") resolves against
    ' whichever workbook is ActiveWorkbook when the control binds, not
    ' necessarily this one. frmManageLibrary's Edit flow has
    ' ConnectorLibrary.xlsx active by the time this form loads, which left
    ' the Type dropdown with no options at all.
    Dim wsLists As Worksheet, r As Long
    Set wsLists = ThisWorkbook.Worksheets("_Lists")
    r = 2
    Do While Len(Trim$(CStr(wsLists.Cells(r, 4).Value))) > 0
        cboType.AddItem wsLists.Cells(r, 4).Value
        r = r + 1
    Loop
    If cboType.ListCount > 0 Then cboType.ListIndex = 0
End Sub

' Called (after Load, before Show) by frmManageLibrary's cmdEdit_Click,
' which has already seeded _Edit's scratch pins via modPinEditor.
' LoadScratchPins - this only has to populate the visible fields and
' rebuild the on-screen pin markers from that scratch data. vFields is the
' 1-based Dim vResult(1 To 11) array modLibrary.ReadConnector returns.
Public Sub LoadForEdit(ByVal sConnectorID As String, ByVal vFields As Variant, wsLibPhotos As Worksheet)
    mConnectorID = sConnectorID
    mOriginalConnectorID = sConnectorID

    txtName.Text = CStr(vFields(2))
    txtManufacturer.Text = CStr(vFields(3))
    txtPartNumber.Text = CStr(vFields(4))
    cboType.Text = CStr(vFields(5))
    txtPinCount.Text = CStr(vFields(6))
    txtNotes.Text = CStr(vFields(7))

    LoadExistingPhoto sConnectorID, wsLibPhotos
    RebuildPinListFromScratch
End Sub

' The embedded library Shape stays the source of truth for the harness
' chart (EmbedConnectorPhoto/modSnapshot), but re-deriving a preview from
' it here would mean re-exporting via Shape.Copy/Chart.Paste, which is
' unreliable for VBA-triggered clipboard operations on this machine
' (manual verification, phase-2-manual-verification.md, 2b/2c). Instead,
' cmdSave_Click keeps a plain on-disk cache of the original photo file
' (CachePhotoPath) alongside the library, purely via FileCopy - no
' clipboard involved - and this reads straight from that cache.
Private Sub LoadExistingPhoto(ByVal sConnectorID As String, wsLibPhotos As Worksheet)
    Dim sCachePath As String
    sCachePath = modLibrary.CachePhotoPath(ThisWorkbook.Path, sConnectorID, "jpg")

    If Len(Dir$(sCachePath)) = 0 Then
        ' No cache yet - predates this fix, or an earlier save's cache
        ' write never happened (e.g. edited without ever picking a photo).
        ' One-time backfill attempt from the embedded Shape: same
        ' reliability caveat ExportShapeToFile always had (not guaranteed
        ' to work - see manual verification, phase-2-manual-verification.md,
        ' 2b/2c), but gives this connector a chance to get a cache going
        ' forward instead of never having one.
        Dim shp As Shape
        On Error Resume Next
        Set shp = wsLibPhotos.Shapes("PHOTO_" & sConnectorID)
        On Error GoTo 0
        If Not shp Is Nothing Then modLibrary.ExportShapeToFile shp, sCachePath, "JPG"
    End If
    If Len(Dir$(sCachePath)) = 0 Then Exit Sub

    Dim pic As IPictureDisp
    Set pic = LoadPicture(sCachePath)
    If pic Is Nothing Then Exit Sub

    Dim vFit As Variant
    vFit = modPinEditor.FitAspectRatio(CDbl(pic.Width), CDbl(pic.Height), PHOTO_BOX_WIDTH, PHOTO_BOX_HEIGHT)
    If IsEmpty(vFit) Then Exit Sub

    imgPhoto.PictureSizeMode = fmPictureSizeModeStretch
    imgPhoto.Picture = pic
    imgPhoto.Width = vFit(0)
    imgPhoto.Height = vFit(1)

    mPhotoPath = sCachePath
End Sub

Private Sub RebuildPinListFromScratch()
    Dim vPins As Variant, i As Long, nPinNumber As Long
    Dim dLabelX As Double, dLabelY As Double

    vPins = modLibrary.ReadPinsForConnector(ThisWorkbook.Worksheets("_Edit"), _
        modPinEditor.SCRATCH_FIRST_ROW, modPinEditor.SCRATCH_LAST_ROW, mConnectorID)
    If IsEmpty(vPins) Then Exit Sub

    For i = LBound(vPins, 1) To UBound(vPins, 1)
        nPinNumber = CLng(vPins(i, 2))
        lstPins.AddItem "Pin " & CStr(nPinNumber)
        mListPinNumbers.Add nPinNumber
        dLabelX = CDbl(vPins(i, 6))
        dLabelY = CDbl(vPins(i, 7))
        AddMarkerControl nPinNumber, dLabelX * imgPhoto.Width, dLabelY * imgPhoto.Height
        If nPinNumber >= mNextPinNumber Then mNextPinNumber = nPinNumber + 1
    Next i
End Sub

Private Sub cmdLoadPhoto_Click()
    ' mConnectorID (below) is computed from Name/Part Number at the moment
    ' the photo loads and never recomputed - placing pins before both are
    ' filled in silently does nothing (mConnectorID is blank). Requiring
    ' both first, rather than letting the photo load and pin placement fail
    ' silently, is the fix flagged in phase-2-manual-verification.md.
    If Len(Trim$(txtName.Text)) = 0 Or Len(Trim$(txtPartNumber.Text)) = 0 Then
        MsgBox "Enter Name and Part Number before loading a photo.", vbExclamation
        Exit Sub
    End If

    ' Restricted to JPG: LoadPicture's legacy OLE picture loader unreliably
    ' rejects valid PNGs (error 481) on some Windows/Office configurations.
    ' JPG loads reliably, so the file picker only offers formats LoadPicture
    ' actually handles here rather than routing through a workaround.
    Dim sPath As String
    sPath = Application.GetOpenFilename( _
        "Pictures (*.jpg; *.jpeg), *.jpg;*.jpeg")
    If sPath = "False" Then Exit Sub

    Dim pic As IPictureDisp
    Set pic = LoadPicture(sPath)
    If pic Is Nothing Then Exit Sub

    ' HIMETRIC-to-pixel conversion cancels out in a ratio - only the ratio
    ' between Width and Height matters here.
    Dim vFit As Variant
    vFit = modPinEditor.FitAspectRatio(CDbl(pic.Width), CDbl(pic.Height), PHOTO_BOX_WIDTH, PHOTO_BOX_HEIGHT)
    If IsEmpty(vFit) Then Exit Sub

    imgPhoto.PictureSizeMode = fmPictureSizeModeStretch
    imgPhoto.Picture = pic
    imgPhoto.Width = vFit(0)
    imgPhoto.Height = vFit(1)

    mPhotoPath = sPath
    mConnectorID = modLibrary.SlugifyConnectorID(Trim$(txtPartNumber.Text), Trim$(txtName.Text))
End Sub

Private Sub imgPhoto_MouseUp(ByVal Button As Integer, ByVal Shift As Integer, _
                             ByVal X As Single, ByVal Y As Single)
    If Len(mConnectorID) = 0 Then Exit Sub

    Dim dNormX As Double, dNormY As Double
    dNormX = X / imgPhoto.Width
    dNormY = Y / imgPhoto.Height

    If tglPlacePins.Value = True Then
        Dim nPinCount As Long
        If Not IsNumeric(txtPinCount.Text) Or CLng(Val(txtPinCount.Text)) <= 0 Then
            MsgBox "Enter a valid Pin Count before placing pins.", vbExclamation
            Exit Sub
        End If
        nPinCount = CLng(Val(txtPinCount.Text))
        If lstPins.ListCount >= nPinCount Then
            MsgBox "All " & CStr(nPinCount) & " pins have been placed.", vbExclamation
            Exit Sub
        End If

        Dim sLabel As String
        sLabel = "Pin " & CStr(mNextPinNumber)

        If modPinEditor.PlacePin(ThisWorkbook.Worksheets("_Edit"), mConnectorID, mNextPinNumber, _
                                 sLabel, dNormX, dNormY) Then
            AddMarkerControl mNextPinNumber, X, Y
            lstPins.AddItem sLabel
            mListPinNumbers.Add mNextPinNumber
            mNextPinNumber = mNextPinNumber + 1
        End If
    ElseIf lstPins.ListIndex >= 0 Then
        ' A pin is selected and Place Pins is off - clicking the image moves
        ' that pin's anchor. The marker travels with it only if it was still
        ' sitting on the anchor (modPinEditor.MoveAnchor decides that); either
        ' way, reposition the on-screen marker to match its new label position.
        Dim nPinNumber As Long
        nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)
        If modPinEditor.MoveAnchor(ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber, dNormX, dNormY) Then
            RepositionMarkerControl nPinNumber
        End If
    End If
End Sub

Private Sub RepositionMarkerControl(ByVal nPinNumber As Long)
    Dim marker As clsPinMarker
    On Error Resume Next
    Set marker = mMarkers(CStr(nPinNumber))
    On Error GoTo 0
    If marker Is Nothing Then Exit Sub

    Dim vPins As Variant, i As Long, dLabelX As Double, dLabelY As Double
    vPins = modLibrary.ReadPinsForConnector(ThisWorkbook.Worksheets("_Edit"), _
        modPinEditor.SCRATCH_FIRST_ROW, modPinEditor.SCRATCH_LAST_ROW, mConnectorID)
    If IsEmpty(vPins) Then Exit Sub

    For i = LBound(vPins, 1) To UBound(vPins, 1)
        If CLng(vPins(i, 2)) = nPinNumber Then
            dLabelX = CDbl(vPins(i, 6))
            dLabelY = CDbl(vPins(i, 7))
            Exit For
        End If
    Next i

    Dim lbl As MSForms.Label
    Set lbl = marker.LabelControl
    lbl.Left = imgPhoto.Left + dLabelX * imgPhoto.Width - (lbl.Width / 2)
    lbl.Top = imgPhoto.Top + dLabelY * imgPhoto.Height - (lbl.Height / 2)
End Sub

Private Sub AddMarkerControl(ByVal nPinNumber As Long, ByVal sngX As Single, ByVal sngY As Single)
    Dim lbl As MSForms.Label
    Set lbl = Me.Controls.Add("Forms.Label.1", "lblMarker" & CStr(nPinNumber), True)
    lbl.Caption = CStr(nPinNumber)
    lbl.Width = PIN_MARKER_SIZE
    lbl.Height = PIN_MARKER_SIZE
    lbl.Font.Size = 8
    lbl.Left = imgPhoto.Left + sngX - (lbl.Width / 2)
    lbl.Top = imgPhoto.Top + sngY - (lbl.Height / 2)
    lbl.TextAlign = fmTextAlignCenter
    lbl.BackStyle = fmBackStyleOpaque
    lbl.BackColor = RGB(255, 255, 255)
    lbl.BorderStyle = fmBorderStyleSingle

    Dim marker As clsPinMarker
    Set marker = New clsPinMarker
    marker.PinNumber = nPinNumber
    marker.ConnectorID = mConnectorID
    Set marker.ScratchSheet = ThisWorkbook.Worksheets("_Edit")
    Set marker.PhotoControl = imgPhoto
    Set marker.LabelControl = lbl
    mMarkers.Add marker, CStr(nPinNumber)
End Sub

Private Sub cmdDeletePin_Click()
    If lstPins.ListIndex < 0 Then Exit Sub
    Dim nPinNumber As Long
    nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)

    modPinEditor.RemovePin ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber
    On Error Resume Next
    Me.Controls.Remove "lblMarker" & CStr(nPinNumber)
    mMarkers.Remove CStr(nPinNumber)
    On Error GoTo 0
    mListPinNumbers.Remove lstPins.ListIndex + 1
    lstPins.RemoveItem lstPins.ListIndex
End Sub

Private Sub cmdClearPins_Click()
    modPinEditor.ClearScratchPins ThisWorkbook.Worksheets("_Edit")

    Dim marker As Variant
    For Each marker In mMarkers
        On Error Resume Next
        Me.Controls.Remove marker.LabelControl.Name
        On Error GoTo 0
    Next marker
    Set mMarkers = New Collection
    Set mListPinNumbers = New Collection
    lstPins.Clear
    mNextPinNumber = 1
End Sub

Private Sub cmdSnapLabel_Click()
    If lstPins.ListIndex < 0 Then Exit Sub
    Dim nPinNumber As Long
    nPinNumber = mListPinNumbers(lstPins.ListIndex + 1)
    If modPinEditor.SnapLabelToPin(ThisWorkbook.Worksheets("_Edit"), mConnectorID, nPinNumber) Then
        RepositionMarkerControl nPinNumber
    End If
End Sub

Private Sub cmdSave_Click()
    Dim lib As Workbook
    Set lib = Workbooks.Open(ThisWorkbook.Path & "\ConnectorLibrary.xlsx")

    ' A collision only matters when the row it would overwrite belongs to a
    ' DIFFERENT connector than the one this session opened for editing -
    ' re-saving the connector you're editing, unchanged, must not flag itself.
    If modLibrary.FindConnectorRow(lib.Worksheets("Connectors"), 2, modLibrary.LIB_ROW_CAP, mConnectorID) > 0 _
            And StrComp(mConnectorID, mOriginalConnectorID, vbTextCompare) <> 0 Then
        MsgBox "Part Number already exists in the library (" & mConnectorID & "). Choose a different Part Number.", vbExclamation
        lib.Close SaveChanges:=False
        Exit Sub
    End If

    Dim sNowUtc As String
    sNowUtc = Format$(Now, "yyyy-mm-ddThh:mm:ssZ")

    If modPinEditor.SaveConnector(lib.Worksheets("Connectors"), lib.Worksheets("Pins"), _
            lib.Worksheets("Photos"), ThisWorkbook.Worksheets("_Edit"), mConnectorID, _
            Trim$(txtName.Text), Trim$(txtManufacturer.Text), Trim$(txtPartNumber.Text), _
            cboType.Text, CLng(Val(txtPinCount.Text)), Trim$(txtNotes.Text), mPhotoPath, _
            sNowUtc, sNowUtc, "Local") Then
        lib.Save
        lib.Close SaveChanges:=False

        ' Refresh the on-disk preview cache LoadExistingPhoto reads from -
        ' a plain file copy, no clipboard involved (see LoadExistingPhoto).
        ' Skipped when mPhotoPath already *is* the cache file (editing
        ' without picking a new photo): FileCopy onto itself errors.
        Dim sCachePath As String
        sCachePath = modLibrary.CachePhotoPath(ThisWorkbook.Path, mConnectorID, "jpg")
        If Len(mPhotoPath) > 0 And StrComp(mPhotoPath, sCachePath, vbTextCompare) <> 0 Then
            FileCopy mPhotoPath, sCachePath
        End If

        ' A standard module's variable, not a property on this form: this
        ' form unloads itself right below, and re-reading a property off a
        ' just-unloaded predeclared instance risks silently re-triggering
        ' UserForm_Initialize (which would reset it) rather than returning
        ' the value just set - a real risk given this session's experience
        ' with this form's Load/Show/Unload lifecycle being surprising.
        modConnectorUI.LastSavedConnectorID = mConnectorID
        Unload Me
    Else
        lib.Close SaveChanges:=False
    End If
End Sub

Private Sub cmdCancel_Click()
    modPinEditor.ClearScratchPins ThisWorkbook.Worksheets("_Edit")
    Unload Me
End Sub
