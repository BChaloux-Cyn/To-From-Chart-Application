Option Explicit

Private mLibrary As Workbook
Private mConnectorIDs() As String

Private Sub UserForm_Initialize()
    Set mLibrary = Workbooks.Open(ThisWorkbook.Path & "\ConnectorLibrary.xlsx")
    RefreshList
End Sub

' QueryClose fires for every unload path - a button's Unload Me as well as
' the form's own system Close (X) button - so this is the one place that
' needs to close mLibrary. On Error Resume Next covers the button-click
' paths, which unload the form after already reading what they need; by
' the time QueryClose runs there is nothing left to close.
Private Sub UserForm_QueryClose(Cancel As Integer, CloseMode As Integer)
    On Error Resume Next
    mLibrary.Close SaveChanges:=False
    On Error GoTo 0
End Sub

Private Sub RefreshList()
    mConnectorIDs = modConnectorUI.RefreshConnectorList(mLibrary.Worksheets("Connectors"), lstConnectors)
End Sub

Private Sub cmdEdit_Click()
    If lstConnectors.ListIndex < 0 Then Exit Sub
    Dim sConnectorID As String
    sConnectorID = mConnectorIDs(lstConnectors.ListIndex + 1)

    Dim vFields As Variant
    vFields = modLibrary.ReadConnector(mLibrary.Worksheets("Connectors"), 2, modLibrary.LIB_ROW_CAP, sConnectorID)
    If IsEmpty(vFields) Then Exit Sub

    modPinEditor.LoadScratchPins ThisWorkbook.Worksheets("_Edit"), mLibrary.Worksheets("Pins"), sConnectorID

    ' Load (not Show) instantiates frmConnectorEditor and runs its
    ' UserForm_Initialize, so LoadForEdit can populate it - all while
    ' mLibrary is still open, since LoadForEdit reads the connector's photo
    ' shape straight off mLibrary's Photos sheet.
    Load frmConnectorEditor
    frmConnectorEditor.LoadForEdit sConnectorID, vFields, mLibrary.Worksheets("Photos")

    Unload Me
    frmConnectorEditor.Show
End Sub

Private Sub cmdDelete_Click()
    If lstConnectors.ListIndex < 0 Then Exit Sub
    Dim sConnectorID As String
    sConnectorID = mConnectorIDs(lstConnectors.ListIndex + 1)

    If MsgBox("Delete " & sConnectorID & " from the library? This cannot be undone.", _
              vbYesNo + vbQuestion) <> vbYes Then Exit Sub

    modLibrary.DeleteConnector mLibrary.Worksheets("Connectors"), 2, modLibrary.LIB_ROW_CAP, sConnectorID
    modLibrary.DeletePinsForConnector mLibrary.Worksheets("Pins"), 2, modLibrary.LIB_ROW_CAP, sConnectorID
    modLibrary.RemoveConnectorPhoto mLibrary.Worksheets("Photos"), sConnectorID
    mLibrary.Save

    RefreshList
End Sub

Private Sub cmdClose_Click()
    Unload Me
End Sub
